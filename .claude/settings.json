{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "blockWritesOutsideWorkingDirectories": true,
    "allow": [
      "Edit(/**)",
      "Bash(just check)",
      "Bash(just fmt)",
      "Bash(just clippy)",
      "Bash(just test)",
      "Bash(just doc)",
      "Bash(just wasm-core)",
      "Bash(just diagrams-check)",
      "Bash(just build)",
      "Bash(just web-build)",
      "Bash(just web-install)",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo test *)",
      "Bash(cargo nextest *)",
      "Bash(cargo doc *)",
      "Bash(cargo insta test *)",
      "Bash(cargo tree *)",
      "Bash(cargo metadata *)",
      "Bash(pnpm -C web build)",
      "Bash(pnpm -C web test *)",
      "Bash(pnpm -C web lint *)",
      "Bash(pnpm -C web install --frozen-lockfile)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --list *)",
      "Bash(git blame *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(git checkout *)",
      "Bash(git restore *)",
      "Bash(git switch *)",
      "Bash(git stash *)",
      "Bash(just hooks-install)",
      "Bash(cargo add *)",
      "Bash(cargo remove *)",
      "Bash(cargo install *)",
      "Bash(pnpm add *)",
      "Bash(pnpm -C web add *)",
      "Bash(npx *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(git tag *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git clean *)",
      "Bash(git merge *)",
      "Bash(git cherry-pick *)",
      "Bash(git filter-branch *)",
      "Bash(git remote *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(cargo publish *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
